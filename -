}

.storico-pagination {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16px;
  padding: 8px 0 4px;
  font-size: 12px;
  color: #777777;
}

.storico-page-size {
  display: flex;
  align-items: center;
  gap: 8px;
}

.storico-page-sel {
  border: 1px solid #E0E0E0;
  border-radius: 4px;
  padding: 3px 6px;
  font-size: 12px;
  font-family: "Open Sans", sans-serif;
  background: #FFFFFF;
  cursor: pointer;
}

.fields-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 24px;
  padding-left: 16px;
}

.storico-filter-list {
  display: flex;
  flex-direction: column;
}

.storico-filter-item {
  display: flex;
  align-items: baseline;
  gap: 10px;
  font-size: 12px;
  padding: 7px 0;
  border-bottom: 1px solid #F0F0F0;
}
.storico-filter-item:last-child {
  border-bottom: none;
}

.storico-filter-key {
  font-weight: 600;
  color: #777777;
  min-width: 140px;
  flex-shrink: 0;
  font-size: 11px;
}

.storico-filter-val {
  color: #444444;
}

.storico-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.storico-col-group {
  margin-bottom: 12px;
}
.storico-col-group:last-child {
  margin-bottom: 0;
}

.storico-col-group-hdr {
  font-size: 10px;
  font-weight: 700;
  color: #888888;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.detail-grid {
  display: grid;
  grid-template-columns: 130px 1fr;
  row-gap: 10px;
}

.detail-lbl {
  font-size: 11px;
  font-weight: 600;
  color: #888888;
  align-self: center;
}

.detail-val {
  font-size: 12px;
  color: #333333;
  align-self: center;
}
.detail-val.dash {
  color: #BDBDBD;
  font-style: italic;
}
.detail-val.mono {
  font-family: monospace;
  font-size: 11px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.storico-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px 24px;
}

.storico-detail-row {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.storico-detail-lbl {
  font-size: 10px;
  font-weight: 600;
  color: #888888;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.storico-detail-val {
  font-size: 13px;
  color: #333333;
}
.storico-detail-val.is-dash {
  color: #BDBDBD;
  font-style: italic;
}

.sd-meta-grid {
