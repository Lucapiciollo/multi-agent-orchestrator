  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(235, 94, 45, 0.15);
}

.sd-meta-cell {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding-right: 16px;
}

.sd-meta-lbl {
  font-size: 9px;
  font-weight: 700;
  color: #888888;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.sd-meta-val {
  font-size: 12px;
  font-weight: 600;
  color: #333333;
}
.sd-meta-val.is-dash {
  color: #9E9E9E;
  font-weight: 400;
  font-style: italic;
}

.preview-table-wrap {
