  padding-right: 10px;
}
.storico-table col.col-template {
  width: 22%;
}
.storico-table col.col-file {
  width: 28%;
}
.storico-table tbody td {
  padding: 11px 14px;
  border-bottom: 1px solid #F0F0F0;
  color: #444444;
  vertical-align: middle;
}
.storico-table tbody td:last-child {
  padding-left: 6px;
  padding-right: 10px;
}
.storico-table tbody tr {
  transition: background 120ms;
  cursor: pointer;
}
.storico-table tbody tr:last-child td {
  border-bottom: none;
}
.storico-table tbody tr:hover {
  background: #F5F5F5;
}

.storico-filename {
  font-family: monospace;
  font-size: 11px;
