  margin-bottom: 12px;
  overflow-x: auto;
  width: 100%;
}

.storico-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  table-layout: auto;
}
.storico-table thead th {
  background: #F5F5F5;
  padding: 10px 14px;
  text-align: left;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: #888888;
  border-bottom: 2px solid #E0E0E0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.storico-table thead th:last-child {
