{
  "id": "html-to-angular-library",
  "objective": "Convertire un prototipo HTML in una libreria Angular non-standalone, modulare, responsive e validata.",
  "projectRoot": ".",
  "contextFiles": [
    "workspace/context/project.json",
    "workspace/context/constraints.json"
  ],
  "createGitCheckpoints": false,
  "tasks": [
    {
      "id": "prototype-analysis",
      "title": "Analisi prototipo",
      "description": "Mappare pagine, componenti, navigazione, dipendenze e comportamenti.",
      "agentId": "angular-architecture-agent",
      "skillIds": [],
      "dependencies": [],
      "inputPaths": ["workspace/input/prototype/**"],
      "outputPaths": ["workspace/reports/component-map.json"],
      "validationCriteria": [
        "Tutte le pagine sono mappate",
        "Componenti riutilizzabili identificati",
        "Nessun macro-componente proposto"
      ],
      "status": "pending",
      "attempts": 0
    },
    {
      "id": "library-generation",
      "title": "Generazione libreria Angular",
      "description": "Creare moduli, routing, pagine, componenti, servizi e public API.",
      "agentId": "angular-architecture-agent",
      "skillIds": [],
      "dependencies": ["prototype-analysis"],
      "inputPaths": [
        "workspace/input/prototype/**",
        "workspace/reports/component-map.json"
      ],
      "outputPaths": ["projects/generated-library/**"],
      "validationCriteria": [
        "Build riuscita",
        "Angular non-standalone",
        "Un componente per cartella",
        "SCSS separati per versione"
      ],
      "status": "pending",
      "attempts": 0
    },
    {
      "id": "ngrx-generation",
      "title": "Generazione store NgRx",
      "description": "Creare feature state, actions, reducer, effects, selectors e facade.",
      "agentId": "ngrx-agent",
      "skillIds": [],
      "dependencies": ["library-generation"],
      "inputPaths": ["projects/generated-library/**"],
      "outputPaths": ["projects/generated-library/src/lib/store/**"],
      "validationCriteria": [
        "Store compilabile",
        "Feature state isolato",
        "Loading ed error gestiti"
      ],
      "status": "pending",
      "attempts": 0
    },
    {
      "id": "responsive-validation",
      "title": "Responsive e test visuali",
      "description": "Correggere il responsive e verificare tutte le risoluzioni previste.",
      "agentId": "responsive-agent",
      "skillIds": [],
      "dependencies": ["library-generation", "ngrx-generation"],
      "inputPaths": ["projects/generated-library/**"],
      "outputPaths": [
        "projects/generated-library/**",
        "workspace/screenshots/**",
        "workspace/reports/responsive.md"
      ],
      "validationCriteria": [
        "Nessun overflow involontario",
        "Layout mobile utilizzabile",
        "Screenshot prodotti",
        "Desktop non degradato"
      ],
      "status": "pending",
      "attempts": 0
    },
    {
      "id": "dark-mode",
      "title": "Dark mode isolata",
      "description": "Aggiungere tema scuro separato senza contaminare versioni o applicazione host.",
      "agentId": "dark-mode-agent",
      "skillIds": [],
      "dependencies": ["library-generation"],
      "inputPaths": ["projects/generated-library/**"],
      "outputPaths": ["projects/generated-library/**"],
      "validationCriteria": [
        "Token semantici presenti",
        "Tema scoped",
        "Versioni indipendenti",
        "Contrasto verificato"
      ],
      "status": "pending",
      "attempts": 0
    },
    {
      "id": "final-review",
      "title": "Revisione indipendente",
      "description": "Verificare build, test, scope, regressioni e criteri di accettazione.",
      "agentId": "quality-review-agent",
      "skillIds": [],
      "dependencies": ["responsive-validation", "dark-mode"],
      "inputPaths": [
        "projects/generated-library/**",
        "workspace/screenshots/**",
        "workspace/reports/**"
      ],
      "outputPaths": ["workspace/reports/final-review.md"],
      "validationCriteria": [
        "Build riuscita",
        "Nessun errore critico",
        "Nessuna modifica fuori scope",
        "Tutti i criteri verificati"
      ],
      "status": "pending",
      "attempts": 0
    }
  ]
}