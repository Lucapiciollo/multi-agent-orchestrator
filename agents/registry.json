[
  {
    "id": "scss-extractor-agent",
    "name": "SCSS Extractor Agent",
    "description": "Analizza pagine web o file CSS/SCSS esistenti e genera un sistema di design tokens completo in stile Bootstrap: variabili, colori, tipografia, spaziatura.",
    "skills": [
      "scss-bootstrap-vars"
    ],
    "tags": [
      "scss",
      "design-tokens",
      "bootstrap",
      "typography",
      "colors"
    ],
    "capabilities": [
      "read-files",
      "write-files",
      "run-browser"
    ],
    "allowedPaths": [
      "projects/**",
      "workspace/**"
    ],
    "forbiddenPaths": [
      ".git/**",
      "node_modules/**"
    ],
    "priority": 100,
    "provider": {
      "type": "copilot",
      "model": "claude-sonnet-5",
      "fallbackProvider": "ollama",
      "fallbackModel": "qwen3-coder:30b",
      "timeoutMs": 900000
    }
  }
]