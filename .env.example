# Provider default quando l'agente non ne dichiara uno: mock | copilot | ollama
AGENT_PROVIDER=mock

# ─── Copilot CLI ─────────────────────────────────────────────────────────────
COPILOT_COMMAND=C:\Users\LucaPiciollo\AppData\Local\Microsoft\WinGet\Packages\GitHub.Copilot_Microsoft.Winget.Source_8wekyb3d8bbwe\copilot.exe
COPILOT_MODEL=claude-sonnet-5
COPILOT_ARGS=--silent,--no-color,--no-ask-user
COPILOT_TIMEOUT_MS=300000

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_TIMEOUT_MS=600000

# ─── Orchestratore ────────────────────────────────────────────────────────────
# Se true, il workflow si interrompe al primo fallimento.
FAIL_FAST=true

# Numero massimo di attività parallele.
MAX_CONCURRENCY=1

# Numero massimo di tentativi per task (sovrascrivibile nel workflow).
MAX_ATTEMPTS=2

# ─── Azure DevOps Watcher ─────────────────────────────────────────────────────
# URL organizzazione (obbligatorio per npm run watch:devops)
ADO_ORG_URL=https://dev.azure.com/agiccloud

# Nome del progetto ADO (obbligatorio)
ADO_PROJECT=TimeVision

# Autenticazione — scegli UNA opzione:
#   Opzione 1 (più semplice): Personal Access Token
ADO_PAT=
#   Opzione 2: lascia ADO_PAT vuoto ed esegui 'az login' (Azure CLI)
#   Opzione 3: Browser OAuth — imposta Tenant e Client di un'app AAD
ADO_TENANT_ID=
ADO_CLIENT_ID=
# Email ADO dell'utente: sovrascrive @Me quando il PAT è di un account diverso
# Esempio: ADO_ME_EMAIL=luca.piciollo@agic.cloud
ADO_ME_EMAIL=
# Intervallo di polling (ms). Default 300000 = 5 minuti
ADO_POLL_INTERVAL_MS=300000
